# Внутренние заметки по задаче, в репозиторий не идут
notes/
CLAUDE.md

# Секреты
.env
.env.local
*.pem
*.key

# Данные организаторов и результаты прогонов.
# Исключение — зафиксированный демонстрационный прогон на открытом датасете.
# Правило только для корня: без слеша оно скрывало и данные, поставляемые внутри
# пакета, — например реестр официальных исправлений.
/data/
/submission/*
!/submission/.gitkeep
# Открытый датасет вместе с ground_truth.json: репозиторий публичный, а ключ
# не наш, чтобы его выкладывать.
agentic-bank-public/
artifacts/*
!artifacts/example-run/
!artifacts/.gitkeep

