{
  "$defs": {
    "AdjustmentAction": {
      "enum": [
        "reclassify",
        "set_missing_amount",
        "exclude",
        "include",
        "set_effective_date",
        "convert_currency",
        "review_no_change"
      ],
      "title": "AdjustmentAction",
      "type": "string"
    },
    "CandidateSource": {
      "description": "Место, которое модель сочла похожим, но недостаточным.\n\nЦитаты здесь нет и быть не может: если бы фрагмент с величиной нашёлся, это был\nбы факт, а не отказ. Адрес всё равно проверяется по переписи — выдуманное имя\nфайла в отказе стоит ровно столько же, сколько в утверждении.",
      "properties": {
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "file_name",
        "page"
      ],
      "title": "CandidateSource",
      "type": "object"
    },
    "Currency": {
      "enum": [
        "USD",
        "EUR",
        "KZT"
      ],
      "title": "Currency",
      "type": "string"
    },
    "Derivation": {
      "description": "Величина, которой в отчётности нет строкой, но которая из неё выводится.",
      "properties": {
        "amount": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Amount",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fact_kind": {
          "title": "Fact Kind",
          "type": "string"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/DerivationTerm"
          },
          "minItems": 2,
          "title": "Terms",
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "requirement_id",
        "fact_kind",
        "unit",
        "identity",
        "terms",
        "amount",
        "confidence"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DerivationTerm": {
      "description": "Одно раскрытое число, входящее в выводимую величину.",
      "properties": {
        "amount": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Amount",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "sign": {
          "$ref": "#/$defs/Sign"
        }
      },
      "required": [
        "label",
        "sign",
        "amount",
        "evidence"
      ],
      "title": "DerivationTerm",
      "type": "object"
    },
    "Evidence": {
      "description": "Адрес утверждения: где напечатано и что именно там написано.",
      "properties": {
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "file_name",
        "page",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ProposedAdjustment": {
      "description": "Изменение операции, предписанное документом.\n\nПоля обязательные для конкретного действия проверяются не здесь, а при сборке\nнастоящей корректировки: там уже есть модель на каждое действие, и повторять её\nограничения на проводе значило бы держать два описания одного контракта.",
      "properties": {
        "action": {
          "$ref": "#/$defs/AdjustmentAction"
        },
        "amount": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "considered": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Considered"
        },
        "counterparty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterparty"
        },
        "currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "from_currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "new_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Value"
        },
        "old_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Value"
        },
        "rate": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "selector_amount": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector Amount"
        },
        "selector_currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "to_currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "txn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Txn Id"
        }
      },
      "required": [
        "action",
        "reason",
        "evidence"
      ],
      "title": "ProposedAdjustment",
      "type": "object"
    },
    "ResolvedFact": {
      "description": "Величина, прочитанная под конкретное требование компилятора.",
      "properties": {
        "amount": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Amount",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "currency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fact_kind": {
          "title": "Fact Kind",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "requirement_id",
        "fact_kind",
        "amount",
        "unit",
        "evidence",
        "confidence"
      ],
      "title": "ResolvedFact",
      "type": "object"
    },
    "Sign": {
      "description": "Знак слагаемого в выводимой величине.",
      "enum": [
        "plus",
        "minus"
      ],
      "title": "Sign",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "money",
        "ratio",
        "percent",
        "count",
        "days"
      ],
      "title": "Unit",
      "type": "string"
    },
    "UnresolvedReason": {
      "description": "Почему величины в ответе нет.\n\nПричины различаются не для отчётности: `not_found` означает, что документа с\nтакой величиной в наборе нет, и это вопрос к переписи, а `conflicting_sources` —\nчто документов два и они спорят, и это вопрос к разбору. Одно чинится чтением\nновых страниц, другое — правилом разрешения спора.",
      "enum": [
        "not_found",
        "insufficient_evidence",
        "conflicting_sources",
        "unsupported_derivation"
      ],
      "title": "UnresolvedReason",
      "type": "string"
    },
    "UnresolvedRequirement": {
      "description": "Требование, на которое модель отвечает отказом.\n\nОтказ — такой же ответ, как число, и потому обязателен. Молчание вместо него\nнеотличимо от оборванного ответа и забытого элемента батча, а стоят они разного:\nчестный отказ оставляет требование открытым, обрыв требует переспросить.",
      "properties": {
        "candidate_source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CandidateSource"
          },
          "title": "Candidate Source Refs",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/UnresolvedReason"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "reason",
        "explanation"
      ],
      "title": "UnresolvedRequirement",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ответ модели на одного заёмщика.\n\nОтвет, в котором нет ни одной величины, законен: он означает отказ по каждому\nтребованию, и это честнее правдоподобного числа. Но он обязан быть высказан —\nкаждое требование батча называется ровно в одном исходе.",
  "properties": {
    "adjustments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedAdjustment"
      },
      "title": "Adjustments",
      "type": "array"
    },
    "derivations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Derivation"
      },
      "title": "Derivations",
      "type": "array"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResolvedFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "unresolved_requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnresolvedRequirement"
      },
      "title": "Unresolved Requirements",
      "type": "array"
    }
  },
  "title": "ResolverResponse",
  "type": "object"
}
