    "SourceAuthority": {
      "description": "Можно ли опираться на документ при расчёте.\n\nПромежуточная ведомость аудитора и заменённая редакция договора читаются и\nхранятся, но менять по ним ответ нельзя. Разделение статуса документа и права\nна него опираться нужно потому, что второе зависит не только от самого\nдокумента: черновик перестаёт действовать, когда у того же заёмщика появился\nокончательный отчёт.",
      "enum": [
        "authoritative",
        "recorded",
        "ignored"
      ],
      "title": "SourceAuthority",
      "type": "string"
    },
    "SourceRef": {
      "description": "Адрес фрагмента в исходном документе.\n\nКаждое утверждение системы адресуется этой тройкой, и по ней же строится вырезка\nстраницы для карточки решения. Тип, статус и номер заключения носятся вместе с\nадресом: без них нельзя ответить, почему один вывод применён, а другой отклонён.",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "authority": {
          "$ref": "#/$defs/SourceAuthority",
          "default": "recorded"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "file_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "File Hash",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocumentKind",
          "default": "unrelated"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "report_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Number"
        },
        "status": {
          "$ref": "#/$defs/DocumentStatus",
          "default": "current"
        }
      },
      "required": [
        "file_hash",
        "file_name",
        "page"
      ],
      "title": "SourceRef",
      "type": "object"
    },
