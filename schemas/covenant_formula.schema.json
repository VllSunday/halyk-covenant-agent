        "selector"
      ],
      "title": "LedgerCount",
      "type": "object"
    },
    "LedgerSum": {
      "description": "Сумма модулей отобранных операций.\n\nМодуль, а не знак: расходы в реестре отрицательны, а `actual` по условию задачи\nвсегда положителен. Знак несёт `Direction`, и складывать разнонаправленные строки\nбез него бессмысленно.",
      "properties": {
        "op": {
          "const": "ledger_sum",
          "default": "ledger_sum",
          "title": "Op",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/Selector"
        }
      },
      "required": [
        "selector"
      ],
      "title": "LedgerSum",
      "type": "object"
    },
    "Operator": {
      "enum": [
        "ge",
        "gt",
        "le",
        "lt",
        "eq",
        "ne"
      ],
      "title": "Operator",
      "type": "string"
    },
