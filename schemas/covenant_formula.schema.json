          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "Absolute",
      "type": "object"
    },
    "BoundingBox": {
      "description": "Координаты в системе PyMuPDF: начало в левом верхнем углу, единица — пункт.",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
