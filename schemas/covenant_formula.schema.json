    "RelatedParty": {
      "description": "Отбор по связанности контрагента.\n\nПорог связанности свой у каждого заёмщика и объявлен в его досье KYC, поэтому\nздесь стоит только намерение — конкретные контрагенты подставляются исполнителем\nиз фактов.",
      "enum": [
        "any",
        "only",
        "exclude"
      ],
      "title": "RelatedParty",
      "type": "string"
    },
    "Rounding": {
      "enum": [
        "half_up",
        "half_even"
      ],
      "title": "Rounding",
      "type": "string"
    },
    "RoundingSpec": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/Rounding",
          "default": "half_up"
        },
        "scale": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        }
      },
      "title": "RoundingSpec",
