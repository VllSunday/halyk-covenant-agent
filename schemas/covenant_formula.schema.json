    "Direction": {
      "description": "Знак операции в реестре. Расходы записаны отрицательными суммами.",
      "enum": [
        "inflow",
        "outflow",
        "any"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DocumentKind": {
      "description": "Тип документа. Определяется по содержимому: имена файлов обезличены.",
      "enum": [
        "loan_agreement",
        "audit_procedures",
        "financial_notes",
        "kyc_file",
        "treasury_memo",
        "unrelated"
      ],
      "title": "DocumentKind",
      "type": "string"
    },
    "DocumentStatus": {
      "description": "Действует ли документ и является ли он окончательным.\n\nДве оси уложены в одну шкалу намеренно: у договора значимо, не заменён ли он\nновой редакцией, у аудиторского отчёта — не является ли он черновиком. Обе\nотвечают на один вопрос — можно ли на документ опираться.",
      "enum": [
        "current",
        "superseded",
        "draft",
        "final"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "EvidenceMode": {
      "description": "Как выбирается транзакция-улика.\n\nКонтрфактически — значит перебором: строка считается уликой, если без неё вердикт\nменяется. Правил вида «самая крупная» здесь нет намеренно, условие задачи прямо\nотвергает их.",
      "enum": [
        "counterfactual",
        "none"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "ExternalMetric": {
      "description": "Величина, которой в датасете может не быть.\n\nСуществует ради честного отказа: подставить сюда число, восстановленное из\nэталона, значит получить правильный ответ на открытом наборе и молчаливо неверный\nна приватном. Исполнитель обязан вернуть отказ, а не догадку.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "op": {
          "const": "external",
          "default": "external",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "ExternalMetric",
      "type": "object"
    },
    "FactValue": {
      "description": "Величина из документа, а не из реестра.\n\nОбязательство по программе выходных пособий, порог существенности разовых статей,\nдоля дочерних организаций в залоге — всё это раскрыто только в примечаниях и\nотдельной проводки не имеет.",
      "properties": {
        "above_one_off_policy": {
          "default": false,
          "title": "Above One Off Policy",
          "type": "boolean"
        },
        "counterparty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterparty"
        },
        "description_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Contains"
        },
        "fact_kind": {
          "title": "Fact Kind",
          "type": "string"
        },
        "op": {
          "const": "fact_value",
          "default": "fact_value",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "fact_kind"
      ],
      "title": "FactValue",
      "type": "object"
    },
    "Largest": {
      "description": "Максимум из нескольких величин.\n\nТак выражается «по отдельности, а не в совокупности»: потолок нарушен, если его\nперешла хотя бы одна из статей, и в `actual` идёт та, что ближе всего к порогу.",
      "properties": {
        "op": {
          "const": "max",
          "default": "max",
          "title": "Op",
          "type": "string"
        },
        "values": {
          "items": {
            "discriminator": {
              "mapping": {
                "abs": "#/$defs/Absolute",
                "add": "#/$defs/Sum",
                "constant": "#/$defs/Constant",
                "div": "#/$defs/Ratio",
                "external": "#/$defs/ExternalMetric",
                "fact_value": "#/$defs/FactValue",
                "ledger_count": "#/$defs/LedgerCount",
                "ledger_sum": "#/$defs/LedgerSum",
                "max": "#/$defs/Largest",
                "min": "#/$defs/Smallest",
                "mul": "#/$defs/Product",
                "sub": "#/$defs/Difference"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LedgerSum"
              },
              {
                "$ref": "#/$defs/LedgerCount"
              },
              {
                "$ref": "#/$defs/FactValue"
              },
              {
                "$ref": "#/$defs/Constant"
              },
              {
                "$ref": "#/$defs/ExternalMetric"
              },
              {
                "$ref": "#/$defs/Sum"
              },
              {
                "$ref": "#/$defs/Difference"
              },
              {
                "$ref": "#/$defs/Product"
              },
              {
                "$ref": "#/$defs/Ratio"
              },
              {
                "$ref": "#/$defs/Absolute"
              },
              {
                "$ref": "#/$defs/Largest"
              },
              {
                "$ref": "#/$defs/Smallest"
              }
            ]
          },
          "minItems": 2,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "Largest",
      "type": "object"
    },
    "LedgerCount": {
      "properties": {
        "op": {
          "const": "ledger_count",
          "default": "ledger_count",
          "title": "Op",
          "type": "string"
