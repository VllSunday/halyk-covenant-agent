# Скопируйте в .env и подставьте свой ключ.
# Пайплайн ходит в одного внешнего провайдера; при отсутствии ключа шаг падает с
# явной ошибкой, а не молча деградирует.

OPENAI_API_KEY=

# Модели по этапам. Значения фиксированные, без суффикса -latest: прогон обязан
# воспроизводиться, а плавающий алиас однажды подставит другую версию.
HALYK_COMPILER_MODEL=gpt-5.6-sol
HALYK_OCR_MODEL=gpt-5.6-sol
HALYK_CLASSIFIER_MODEL=gpt-5.6-sol
HALYK_VERIFIER_MODEL=gpt-5.6-sol

# Глубина рассуждения по этапам. Распознавание — задача восприятия, ей хватает low;
# компиляция ковенанта дороже всего по последствиям, поэтому high.
HALYK_OCR_EFFORT=low
HALYK_COMPILER_EFFORT=high
HALYK_VERIFIER_EFFORT=xhigh

# Куда складывать прогоны. По умолчанию artifacts/runs/<run_id>
HALYK_ARTIFACTS_DIR=artifacts

# Параллелизм обращений к моделям. Снижайте при упоре в rate limit.
HALYK_MAX_CONCURRENCY=4

# Шапка Submission.json. Без них solve останавливается до первого вызова модели:
# ответ без команды и почты организаторы не примут, а узнавать об этом после
# оплаченного прогона поздно.
HALYK_TEAM=
HALYK_CONTACT_EMAIL=

# Потолок расходов прогона. Пустое значение — без потолка. Потолок стоимости
# работает только вместе с ценой: без неё расход считается нулевым.
HALYK_MAX_LIVE_CALLS=
# Лимит одного запроса и совокупный лимит всего прогона — разные ограничения.
# HALYK_MAX_INPUT_TOKENS остаётся совместимым старым именем для TOTAL.
HALYK_MAX_INPUT_TOKENS_PER_CALL=
HALYK_MAX_TOTAL_INPUT_TOKENS=
HALYK_MAX_OUTPUT_TOKENS=
HALYK_MAX_COST_USD=
HALYK_PRICE_INPUT_PER_MTOK=0
HALYK_PRICE_OUTPUT_PER_MTOK=0
