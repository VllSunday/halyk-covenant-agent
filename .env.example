# Скопируйте в .env и подставьте свои ключи.
# Пайплайн ходит в три внешних сервиса; при отсутствии ключа соответствующий
# шаг падает с явной ошибкой, а не молча деградирует.

# Компиляция текста ковенанта в типизированный IR
OPENAI_API_KEY=
HALYK_COMPILER_MODEL=gpt-5.6-sol

# OCR для сканов и страниц с непригодным текстовым слоем
MISTRAL_API_KEY=
HALYK_OCR_MODEL=mistral-ocr-latest

# Разбор конфликтных случаев после провала инвариантов
ANTHROPIC_API_KEY=
HALYK_VERIFIER_MODEL=claude-sonnet-5

# Куда складывать прогоны. По умолчанию artifacts/runs/<run_id>
HALYK_ARTIFACTS_DIR=artifacts

# Параллелизм обращений к моделям. Снижайте при упоре в rate limit.
HALYK_MAX_CONCURRENCY=8
